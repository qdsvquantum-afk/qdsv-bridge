{
  "schema_version": "qdsv_bridge_release_manifest.v2",
  "sdk_version": "0.7.1",
  "release_status": "public_release",
  "contracts": {
    "domain_request": "qdsv_bridge_domain.v1",
    "service_response": "qdsv_bridge_public.v1",
    "semantic_composition_capabilities": "qdsv_semantic_composition_engine.v1",
    "semantic_composition_candidate": "qdsv_composite_operation_candidate.v1",
    "portable_artifacts": ["qasm2", "qasm3", "qiskit_blueprint"]
  },
  "qiskit_integration": {
    "adapter": "qdsv_bridge.QDSVBridge and qdsv_bridge.QDSVBridgeArtifact",
    "requires_extra": "qdsv-bridge[qiskit]",
    "scope": "explicit public export, digest verification, then local OpenQASM loading",
    "performs_remote_calls_during_transpile": false
  },
  "distribution_conformance": {
    "policy": "qdsv_bridge_public_distribution.v1",
    "checks_wheel_and_sdist": true,
    "allows_private_implementation_material": false
  },
  "boundaries": {
    "contains_private_compiler": false,
    "contains_internal_intermediate_representation": false,
    "contains_private_operation_synthesis_rules": false,
    "contains_nonpublic_execution_plans": false,
    "executes_qpu": false,
    "performs_physical_routing": false,
    "claims_independent_validation": false
  }
}
