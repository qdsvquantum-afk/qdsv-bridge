{
  "schema_version": "qdsv_benchmark_policy.v0.1",
  "tracks": {
    "semantic": {
      "required": ["frozen_inputs", "separate_expected_outputs", "independent_replay", "mismatch_count"],
      "forbids": ["hardware_claim_from_simulation"]
    },
    "reversibility": {
      "required": ["candidate_preservation", "ancilla_cleanup"],
      "forbids": ["ignoring_invalid_domain_states_without_policy"]
    },
    "logical_resources": {
      "required": ["artifact_role", "qubits", "depth", "operations"],
      "forbids": ["physical_cost_claim_without_target"]
    },
    "common_normalization": {
      "required": ["same_basis", "same_optimization_level", "same_transpiler_seed"],
      "forbids": ["mixing_native_and_normalized_metrics"]
    },
    "hardware": {
      "required": ["backend", "snapshot", "job_identity", "shots", "coverage", "statistical_policy"],
      "forbids": ["counting_inconclusive_as_correct", "attributing_fallback_to_hardware"]
    }
  },
  "outcome_states": [
    "PASS",
    "SEMANTIC_FAIL",
    "CONTRACT_FAIL",
    "RESOURCE_LIMITED",
    "UNSUPPORTED",
    "INVALID_SPEC",
    "NOT_APPLICABLE"
  ]
}
