{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qdsv.example/schemas/conformance-run-manifest-v0.1.json",
  "title": "QDSV Conformance Run Manifest v0.1",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at_utc", "versions", "target", "fixtures", "outputs"],
  "properties": {
    "schema_version": {"const": "qdsv_conformance_run_manifest.v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "versions": {"type": "object"},
    "target": {
      "type": "object",
      "required": ["api_url", "authentication_present"],
      "properties": {
        "api_url": {"type": "string"},
        "authentication_present": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "fixtures": {"type": "object"},
    "outputs": {"type": "object"}
  },
  "additionalProperties": true
}
