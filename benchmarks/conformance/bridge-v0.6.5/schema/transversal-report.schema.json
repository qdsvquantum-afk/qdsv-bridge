{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qdsv.example/schemas/transversal-conformance-report-v0.1.json",
  "title": "QDSV Transversal Conformance Report v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at_utc",
    "target",
    "summary",
    "capability_matrix",
    "checks",
    "omissions"
  ],
  "properties": {
    "schema_version": {"const": "qdsv_transversal_conformance_report.v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "target": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "not_evaluated"]
    },
    "capability_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "state", "execution_policy", "evidence"]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "surface", "conformance_status", "evidence_level", "assertions"]
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "reason", "status"]
      }
    }
  },
  "additionalProperties": true
}
